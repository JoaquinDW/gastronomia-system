# Neon CLI writes the real values to .env.local. Never expose them with NEXT_PUBLIC_.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon Auth URL is pulled by neon deploy; generate a private random cookie secret.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
# Server-side OpenAI key for menu extraction. Never expose as NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MENU_MODEL=gpt-5.4-mini
# Optional, Production only. Root domain for host routing: landing on it, login
# and panel on app.<root> (each business at app.<root>/<slug>), each store on
# <slug>.<root>. Use lvh.me:3000 locally. Empty keeps /t/<slug> and /panel/negocios/<id>.
NEXT_PUBLIC_ROOT_DOMAIN=
# Neon Object Storage for product and cover photos (bucket pedipue-media in neon.ts).
# `neon env pull` writes them; in Vercel add a storage credential's values by hand.
# Empty keeps new photos in Postgres.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
