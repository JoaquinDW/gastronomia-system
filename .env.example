# Neon CLI writes the real values to .env.local. Never expose them with NEXT_PUBLIC_.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon Auth URL is pulled by neon deploy; generate a private random cookie secret.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
# Server-side OpenAI key for menu extraction. Never expose as NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MENU_MODEL=gpt-5.4-mini
# Optional, Production only. Root domain for host routing: landing on it, login
# and panel on app.<root> (each business at app.<root>/<slug>), each store on
# <slug>.<root>. Use lvh.me:3000 locally. Empty keeps /t/<slug> and /panel/negocios/<id>.
NEXT_PUBLIC_ROOT_DOMAIN=
# Delivery map: browser key restricted to the app/store HTTP referrers.
# Enable Maps JavaScript API and Geocoding API. Rebuild after changing this key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional production map ID; DEMO_MAP_ID is used during development.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Neon Object Storage for product and cover photos (bucket pedipue-media in neon.ts).
# `neon env pull` writes them; in Vercel add a storage credential's values by hand.
# Empty keeps new photos in Postgres.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Emails (separados por coma) que ven /panel/admin con todos los negocios.
# Sin la variable, solo balthasardeweert@gmail.com. Sumá solo cuentas ya creadas.
SUPERADMIN_EMAILS=
# Opcional. WhatsApp (con código de país) para pagos y postulaciones a Socios
# Fundadores. Sin la variable se usa 5493794721825.
BILLING_WHATSAPP=
